# Copy to .env and replace all example secrets before exposing the service.
POSTGRES_DB=devops_hub
POSTGRES_USER=devops
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_32_bytes
ACCESS_TOKEN_MINUTES=60
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
